{
  "schema": "craft-scenario-playbooks/v1",
  "application": "wordcraft",
  "id": "business-proposal",
  "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
  "steps": [
    {
      "purpose": "设置页面基本规格",
      "command": "layout.size",
      "params": {
        "name": "A4"
      }
    },
    {
      "purpose": "应用一级标题样式后写入标题",
      "command": "para.style",
      "params": {
        "style": "Heading 1"
      }
    },
    {
      "purpose": "写入方案标题",
      "command": "text.insert",
      "params": {
        "text": "业务方案"
      }
    },
    {
      "purpose": "另起正文段落",
      "command": "text.newParagraph",
      "params": {}
    },
    {
      "purpose": "恢复正文样式",
      "command": "para.style",
      "params": {
        "style": "Normal"
      }
    },
    {
      "purpose": "写入目标、方案、成本与验收",
      "command": "text.insert",
      "params": {
        "text": "目标\n方案与边界\n成本依据\n验收方式"
      }
    }
  ],
  "check": "标题样式可生成目录，方案中的承诺、数字、版本和责任人一致。",
  "boundary": "样式名需由 styles.list 确认；英文内置名在当前运行时不一定等于界面本地化名称。",
  "templateOnly": true,
  "argumentPolicy": "示例参数必须按当前输入、选择和实际返回ID替换；$变量先解析，数组变量整字段替换，不能将本文件直接当原生CLI脚本执行。"
}
