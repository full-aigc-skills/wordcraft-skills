{
  "schema": "craft-scenario-playbooks/v1",
  "application": "wordcraft",
  "id": "resume-layout",
  "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
  "steps": [
    {
      "purpose": "设置简历页面与适度边距",
      "command": "layout.size",
      "params": {
        "name": "A4"
      }
    },
    {
      "purpose": "使用标准段落而非空格排版",
      "command": "layout.margins",
      "params": {
        "top": 36,
        "bottom": 36,
        "left": 42,
        "right": 42
      }
    },
    {
      "purpose": "写入真实履历",
      "command": "text.insert",
      "params": {
        "text": "姓名与联系方式\n工作经历\n教育经历\n技能与项目"
      }
    },
    {
      "purpose": "检查文档结构",
      "command": "document.inspect",
      "params": {
        "text": true
      }
    }
  ],
  "check": "姓名联系信息准确，日期连续，PDF无截字，文本可复制。",
  "boundary": "示例结构需替换为真实履历；不虚构岗位、学历和业绩。",
  "templateOnly": true,
  "argumentPolicy": "示例参数必须按当前输入、选择和实际返回ID替换；$变量先解析，数组变量整字段替换，不能将本文件直接当原生CLI脚本执行。"
}
