{
  "schema": "craft-scenario-playbooks/v1",
  "application": "wordcraft",
  "id": "document-comparison",
  "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
  "steps": [
    {
      "purpose": "读取原文结构",
      "command": "document.inspect",
      "params": {
        "text": true
      }
    },
    {
      "purpose": "与修改版生成新比较文档",
      "command": "review.compare",
      "params": {
        "path": "input/revised.docx",
        "showIn": "new",
        "level": "word",
        "formatting": true
      }
    },
    {
      "purpose": "逐项查看修订",
      "command": "review.changes",
      "params": {}
    },
    {
      "purpose": "查看批注上下文",
      "command": "review.comments",
      "params": {}
    }
  ],
  "check": "检查数字、日期、责任条款与表格变化，保留原版与比较版。",
  "boundary": "不执行 acceptAll/rejectAll 作为核对；页眉脚注等差异需单独查看。",
  "templateOnly": true,
  "argumentPolicy": "示例参数必须按当前输入、选择和实际返回ID替换；$变量先解析，数组变量整字段替换，不能将本文件直接当原生CLI脚本执行。"
}
