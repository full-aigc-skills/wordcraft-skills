{
  "schema": "craft-scenario-playbooks/v1",
  "application": "wordcraft",
  "id": "research-report",
  "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
  "steps": [
    {
      "purpose": "设定页面与边距",
      "command": "layout.margins",
      "params": {
        "preset": "normal"
      }
    },
    {
      "purpose": "创建章节标题",
      "command": "para.style",
      "params": {
        "style": "Heading 1"
      }
    },
    {
      "purpose": "输入研究主题",
      "command": "text.insert",
      "params": {
        "text": "研究问题与证据"
      }
    },
    {
      "purpose": "检查全文与页数结构",
      "command": "document.inspect",
      "params": {
        "text": true
      }
    },
    {
      "purpose": "列出拼写问题供判断",
      "command": "review.issues",
      "params": {}
    }
  ],
  "check": "引文、表题、页码和章节对应，结论区分事实、推断与未验证项。",
  "boundary": "review.issues不是事实核查；缺少来源不能用自动语言检查代替。",
  "templateOnly": true,
  "argumentPolicy": "示例参数必须按当前输入、选择和实际返回ID替换；$变量先解析，数组变量整字段替换，不能将本文件直接当原生CLI脚本执行。"
}
