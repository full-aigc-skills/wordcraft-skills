{
  "schema": "craft-scenario-playbooks/v1",
  "application": "wordcraft",
  "id": "meeting-minutes",
  "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
  "steps": [
    {
      "purpose": "插入会议基本信息与决定",
      "command": "text.insert",
      "params": {
        "text": "会议时间：待核实\n参会人：待核实\n决定：\n行动项："
      }
    },
    {
      "purpose": "插入行动项表格",
      "command": "insert.table",
      "params": {
        "rows": 3,
        "cols": 4
      }
    },
    {
      "purpose": "核对全文结构",
      "command": "document.inspect",
      "params": {
        "text": true
      }
    }
  ],
  "check": "区分讨论、决定和待办，行动项包含责任人、截止时间与状态。",
  "boundary": "不得把讨论建议写成已达成决议；逐格填表需要当前table/cell选择。",
  "templateOnly": true,
  "argumentPolicy": "示例参数必须按当前输入、选择和实际返回ID替换；$变量先解析，数组变量整字段替换，不能将本文件直接当原生CLI脚本执行。"
}
