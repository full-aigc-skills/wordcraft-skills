{
  "schema": "craft-scenario-playbooks/v1",
  "application": "wordcraft",
  "id": "document-style",
  "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
  "steps": [
    {
      "purpose": "读取已有样式，避免重复造同义样式",
      "command": "styles.list",
      "params": {}
    },
    {
      "purpose": "定位当前选区的样式",
      "command": "styles.inspect",
      "params": {}
    },
    {
      "purpose": "定位已确认正文；按当前输入替换，匹配失败不得继续套样式",
      "command": "select.text",
      "params": {
        "text": "正文待统一",
        "occurrence": 0
      }
    },
    {
      "purpose": "对选中正文应用统一样式",
      "command": "para.style",
      "params": {
        "style": "Normal"
      }
    },
    {
      "purpose": "复核结构",
      "command": "document.inspect",
      "params": {
        "text": true
      }
    }
  ],
  "check": "标题、正文、图注样式一致，局部强调不被误清除。",
  "boundary": "把select.text替换为真实正文中的唯一短语，先确认选中范围且仅含正文；不全选归一标题，不清除未授权的字符强调。",
  "templateOnly": true,
  "argumentPolicy": "示例参数必须按当前输入、选择和实际返回ID替换；$变量先解析，数组变量整字段替换，不能将本文件直接当原生CLI脚本执行。"
}
